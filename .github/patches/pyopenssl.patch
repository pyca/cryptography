diff --git a/tests/test_native_tls.py b/tests/test_native_tls.py
new file mode 100644
index 0000000..0d57321
--- /dev/null
+++ b/tests/test_native_tls.py
@@ -0,0 +1,183 @@
+"""Ownership and callback regressions for the Rust TLS boundary."""
+
+from __future__ import annotations
+
+import gc
+import socket
+import weakref
+from concurrent.futures import ThreadPoolExecutor
+from typing import Any
+
+import pytest
+from cryptography import x509
+from cryptography.hazmat.bindings._rust import pyopenssl as native
+from cryptography.hazmat.primitives import serialization
+
+from .test_crypto import server_cert_pem, server_key_pem
+
+
+def server_context() -> native.TLSContext:
+    context = native.TLSContext(False)
+    certificate = x509.load_pem_x509_certificate(server_cert_pem)
+    key = serialization.load_pem_private_key(server_key_pem, None)
+    context.use_certificate_der(
+        certificate.public_bytes(serialization.Encoding.DER)
+    )
+    context.use_private_key_der(
+        key.private_bytes(
+            serialization.Encoding.DER,
+            serialization.PrivateFormat.PKCS8,
+            serialization.NoEncryption(),
+        )
+    )
+    return context
+
+
+class Owner:
+    def __init__(
+        self,
+        context: native.TLSContext,
+        server: bool,
+        descriptor: int | None = None,
+    ) -> None:
+        self.connection = native.TLSConnection(context, server, descriptor)
+        self.failure: Exception | None = None
+        self.reentry = False
+        self.events = 0
+
+    def _dispatch_native_callback(
+        self, event: str, info: dict[str, Any], args: tuple[Any, ...]
+    ) -> Any:
+        if event == "info":
+            self.events += 1
+            assert isinstance(info["state"], bytes)
+            if self.reentry:
+                with pytest.raises(RuntimeError, match="reentrant"):
+                    self.connection.info()
+            if self.failure is not None:
+                raise self.failure
+        if event == "verify":
+            return args[-1]
+        if event == "ocsp_client":
+            return True
+        return None
+
+
+def transfer(source: Owner, sink: Owner) -> None:
+    while True:
+        try:
+            data = source.connection.drain_ciphertext(65536)
+        except native.TLSWantRead:
+            return
+        sink.connection.feed_ciphertext(data)
+
+
+def handshake(client: Owner, server: Owner) -> None:
+    complete = [False, False]
+    for _ in range(32):
+        for index, (source, sink) in enumerate(
+            ((client, server), (server, client))
+        ):
+            if not complete[index]:
+                try:
+                    source.connection.handshake(source)
+                except (native.TLSWantRead, native.TLSWantWrite):
+                    pass
+                else:
+                    complete[index] = True
+            transfer(source, sink)
+        if all(complete):
+            return
+    pytest.fail("TLS handshake did not complete")
+
+
+def test_callback_reentry_is_rejected_and_owner_is_collectible() -> None:
+    client = Owner(native.TLSContext(False), False)
+    server = Owner(server_context(), True)
+    server.reentry = True
+    handshake(client, server)
+    assert server.events > 0
+    owner_ref = weakref.ref(server)
+    del server
+    gc.collect()
+    assert owner_ref() is None
+
+
+def test_callback_exception_stays_with_its_connection() -> None:
+    context = server_context()
+    failed = Owner(context, True)
+    other = Owner(context, True)
+    error = ValueError("original callback failure")
+    failed.failure = error
+    with pytest.raises(ValueError) as raised:
+        failed.connection.handshake(failed)
+    assert raised.value is error
+    with pytest.raises(ValueError, match="failed"):
+        failed.connection.handshake(failed)
+    client = Owner(native.TLSContext(False), False)
+    handshake(client, other)
+
+
+def test_blocking_socket_handshakes_release_gil_and_own_descriptors() -> None:
+    left, right = socket.socketpair()
+    client = Owner(native.TLSContext(False), False, left.fileno())
+    server = Owner(server_context(), True, right.fileno())
+    left.close()
+    right.close()
+    with ThreadPoolExecutor(max_workers=1) as executor:
+        done = executor.submit(server.connection.handshake, server)
+        client.connection.handshake(client)
+        done.result(timeout=10)
+    assert client.connection.write(client, b"owned descriptors") == 17
+    assert server.connection.read(server, 64, False) == b"owned descriptors"
+
+
+def test_context_store_proxy_cannot_mutate_a_live_factory() -> None:
+    from OpenSSL import SSL, crypto
+
+    from .test_crypto import root_cert_pem
+
+    context = SSL.Context(SSL.TLS_METHOD)
+    store = context.get_cert_store()
+    assert store is not None
+    root = crypto.load_certificate(crypto.FILETYPE_PEM, root_cert_pem)
+    store.add_cert(root)
+    verification = crypto.X509StoreContext(store, root)
+    verification.verify_certificate()
+    connection = SSL.Connection(context, None)
+    with pytest.raises(ValueError, match="cannot be mutated"):
+        store.add_cert(root)
+    with pytest.raises(ValueError, match="cannot be mutated"):
+        store.set_flags(0)
+    verification.verify_certificate()
+    assert connection.get_context() is context
+
+
+def test_sendall_retry_does_not_repeat_already_written_bytes(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    from OpenSSL import SSL
+
+    class PartialWriter:
+        def __init__(self) -> None:
+            self.received = bytearray()
+            self.block_once = True
+
+        def write(self, owner: object, data: bytes) -> int:
+            if self.received and self.block_once:
+                self.block_once = False
+                raise native.TLSWantWrite()
+            self.received.extend(data[:1])
+            return 1
+
+    connection = SSL.Connection(SSL.Context(SSL.TLS_METHOD), None)
+    writer = PartialWriter()
+    monkeypatch.setattr(connection, "_native", writer)
+    data = bytearray(b"payload")
+    with pytest.raises(SSL.WantWriteError):
+        connection.sendall(data)
+    data[0] = 0
+    with pytest.raises(ValueError, match="original bytes"):
+        connection.sendall(data)
+    assert connection.sendall(b"payload") == 7
+    assert writer.received == b"payload"
